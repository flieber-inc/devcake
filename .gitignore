# Secrets & local config — never commit
.env

# App local state (volume-mounted in containers; may appear locally during dev)
/data/

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node (admin SPA, from M6)
node_modules/
dist/

# Editor/OS noise
.idea/
.vscode/
.DS_Store

# dagu-generated DAG scan index (rewritten on every boot)
dagu/dags/.dag.index

# BuildKit local bake cache (docker-bake.hcl BAKE_CACHE_DIR)
.buildx-cache/

# Gitea credential-bearing backup tarballs (scripts/backup_gitea.sh) — never commit
devcake-gitea-*.tar.gz
