# Secrets & local config — never commit
.env

# App local state (volume-mounted in containers; may appear locally during dev)
/data/

# Per-run Dev workspaces (ADR-0025) — devcake up defaults the host-bind base to
# ./workspaces inside this checkout; run content must never be committed
/workspaces/

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node (admin SPA, from M6)
node_modules/
dist/

# Editor/OS noise
.idea/
.vscode/
.DS_Store

# Claude Code local overrides (per-machine; never commit)
.claude/settings.local.json

# dagu-generated DAG scan index (rewritten on every boot)
dagu/dags/.dag.index

# BuildKit local bake cache (docker-bake.hcl BAKE_CACHE_DIR)
.buildx-cache/

# Host baker pid/log/work (devcake up starts it; not a compose service)
.factory/

# Gitea credential-bearing backup tarballs (scripts/backup_gitea.sh) — never commit
devcake-gitea-*.tar.gz

# App-data backups contain every operator secret in plaintext.
devcake-data-*.tar.gz

# never commit env backups (2026-08-04 incident)
.env.*
.env.bak*
*.env.bak
*.egg-info/
build/
