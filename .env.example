# DevCake environment — copy to .env and fill in. `.env` is gitignored.
#
# SCHEMA v4 (M12): .env holds ONLY stack bootstrap secrets — the things needed
# before the admin GUI itself is up. Everything the operator supplies —
# PMO/forge tokens, model/harness keys, team keys, repo URLs — is entered
# through the Config page and stored 0600 on the app volume, never here.
# Generate strong passwords before first `docker compose up`. Empty or default
# values (change-me*) refuse app boot unless DEVCAKE_ALLOW_INSECURE=1.

# ── Image tag (must match docker buildx bake; default latest) ───────────────
# DEVCAKE_TAG=latest
# TAG and DEVCAKE_TAG are interchangeable for bake; compose reads DEVCAKE_TAG.
# ./up.sh resolves once (process env > .env > latest), exports for bake+compose,
# and upserts into .env so a later plain `docker compose up -d` stays lockstep.

# ── OpenObserve ──────────────────────────────────────────────────────────────
OO_ROOT_EMAIL=admin@example.com
# REQUIRED: set a strong password (not change-me). Used by provisioner + admin.
OO_ROOT_PASSWORD=
# REQUIRED (M8): OO service account the stack authenticates with
# (otel-collector, fluentbit, app log-push). Boot refuses empty email or
# empty/weak password. App boot creates/resyncs this user in OpenObserve
# from OO_INGEST_*. Optional dashboard/alerts only:
#   python3 scripts/provision_oo.py
# Dev containers hold NO OO credentials — they export via the otel-collector.
OO_INGEST_EMAIL=
OO_INGEST_PASSWORD=
# OO_ALERT_WEBHOOK=           # optional; provisions the alert set (docs/15 §6)
# OO_DAILY_COST_ALERT_USD=50  # daily-cost alert threshold (docs/15 §6 item 5)

# ── Internal fallback forge (bundled Gitea — docs/16 M11) ───────────────────
# Stack bootstrap secret: the Gitea admin the app provisions with. REQUIRED;
# boot refuses an empty/weak password. UI: http://localhost:3300
GITEA_ADMIN_USER=devcakeadmin
GITEA_ADMIN_PASSWORD=
# GITEA_UI_URL=http://localhost:3300

# ── Dagu API auth (basic mode; app + your browser use these) ────────────────
DAGU_USER=devcake
# REQUIRED: nonempty strong password (compose fails if empty)
DAGU_PASSWORD=

# ── Redis default-user password (app-only; Devs get per-run ACL users) ──────
REDIS_PASSWORD=

# ── Admin panel basic auth (docs/11-admin-panel.md §5) ──────────────────────
ADMIN_USER=admin
ADMIN_PASSWORD=

# Local sandbox only: allow empty/default passwords (never set in production)
# DEVCAKE_ALLOW_INSECURE=1

# ── UI links shown as buttons in the admin panel (defaults fit local compose)
DAGU_UI_URL=http://localhost:8525
OO_UI_URL=http://localhost:5080

# ── Host docker group gid, for Dagu's sock access
# Host-specific. Prefer: ./up.sh (discovers from /var/run/docker.sock and
# upserts this line). Manual: stat -c %g /var/run/docker.sock
DOCKER_GID=

# ── Per-run workspace base (ADR-0025) — HOST-ABSOLUTE path
# Host-specific, auto-managed: ./up.sh derives $(pwd)/workspaces, mkdirs it
# 0700 and upserts this line; an existing value wins (relocate by editing it,
# then re-run ./up.sh). Dev run dirs live here between the provision and
# harness containers; the tree holds repo source + agent output.
DEVCAKE_WS_HOST=

# (Team key, repository URL, and all credentials are configured through the
#  admin Config page — no env seeds since schema v4. First boot is empty.)
